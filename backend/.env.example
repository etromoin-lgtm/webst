PORT=5000

# ─── SUPABASE / POSTGRESQL DATABASE ─────────────────────────────────────────
# 1. Direct PostgreSQL Connection String (Transaction Pooler Recommended)
DATABASE_URL=postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres

# 2. Supabase API Credentials (from Project Settings -> API)
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ─── ADMIN PANEL & AUTH ─────────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password
JWT_SECRET=generate_a_random_32_char_secret_string
