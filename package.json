{
  "name": "ourcompany-root",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace scripts for OurCompany",
  "scripts": {
    "dev": "npm --prefix web-app run dev",
    "dev:backend": "node backend/index.js",
    "build": "npm --prefix web-app run build",
    "start": "node backend/index.js",
    "postinstall": "npm --prefix backend install && npm --prefix web-app install"
  }
}
