# Backend environment variables (copy to .env and fill in values)
# Never commit real secrets to version control.

PORT=5000
NODE_ENV=production

# Admin credentials (REQUIRED - no insecure defaults)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# JWT signing secret (REQUIRED - generate a strong random value)
JWT_SECRET=CHANGE_ME_64_CHAR_RANDOM_SECRET

# Database (Supabase PostgreSQL in production)
# DATABASE_URL=postgresql://...

# File uploads
UPLOADS_DIR=./uploads
